{
  "name": "rivium-storage-react-native-example",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "android:release": "expo run:android --variant release",
    "ios:release": "expo run:ios --configuration Release",
    "typecheck": "tsc --noEmit",
    "bundle:check": "expo export --platform ios --platform android --output-dir .expo-export-check"
  },
  "dependencies": {
    "@rivium/storage-react-native": "file:../",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-build-properties": "~0.13.3",
    "expo-document-picker": "~13.0.0",
    "expo-file-system": "~18.0.12",
    "expo-image-picker": "~16.0.6",
    "expo-status-bar": "~2.0.1",
    "react": "18.3.1",
    "react-native": "0.76.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~18.3.0",
    "typescript": "~5.3.0"
  }
}
