# Copy to .env (git-ignored) and fill in. Expo bakes EXPO_PUBLIC_* values into
# the JS bundle at build time (debug and release). Public values only: never
# put the server secret (rv_srv_...) here.
EXPO_PUBLIC_RIVIUM_API_KEY=rv_live_xxxxxxxxxxxxxxxx
# Your token server: POST {"userId","expiresIn"} -> {"token"}
EXPO_PUBLIC_RIVIUM_TOKEN_URL=http://192.168.1.20:4000/token
# Optional: POST {"fileId","expiresIn"} -> {"url"}
EXPO_PUBLIC_RIVIUM_SIGNED_URL_ENDPOINT=http://192.168.1.20:4000/signed-url
EXPO_PUBLIC_RIVIUM_PUBLIC_BUCKET=rivium-example-public
EXPO_PUBLIC_RIVIUM_PRIVATE_BUCKET=rivium-example-private-images
EXPO_PUBLIC_RIVIUM_TEST_USER_ID=demo-user
